# wraith-fflag-profile 1
# Max FPS: coarse meshes, blocky world textures, no grass/bloom/SSAO, cheap shadows, 1000 FPS cap. UI stays full size.
# Load on the Roblox window before pressing Play.
roblox_version=version-11f155f3450f4c8e
DebugFRMQualityLevelOverride=1
DebugForceMSAASamples=0
DebugFRMOptionalMSAALevelOverride=0
DebugRenderMeshForceLod=3
DebugRenderMeshesBudgetMb=4
DebugRenderMeshManagerDisableControlByHarmony=1
DebugRenderMeshManagerMaxUtility=1
SlimForceLOD=1
SlimLODBias=1
CSGLevelOfDetailSwitchingDistance=0
CSGLevelOfDetailSwitchingDistanceL12=0
CSGLevelOfDetailSwitchingDistanceL23=0
CSGLevelOfDetailSwitchingDistanceL34=0
EnableCoarseShading=1
DebugForceAnisoOff=1
DebugTextureManagerSkipMips=12
DebugAdditionalNumberOfMipsToSkipForNonAlbedoTextures=10
DebugLimitMinTextureResolutionWhenSkipMips=64
TM2SkipMipsForUnstreamable2=0
GraphicsTextureReductionVulkan=1
GraphicsTextureReductionD3D11=1
ReducedTranscoderTextureDimensionMax=64
SimRuntimeContentTextureTranscodeMaxDim=64
TTranscoderDecalPixelated=1
TextureCompositorLowResFactor=4
TerrainOTAMaxTextureSize=32
TerrainAtlasTileSize=32
SSAOMipLevels=0
BloomFrmCutoff=21
FRMMaxGrassDistance=0
FRMMinGrassDistance=0
RenderShadowmapBias=75
RenderShadowHugeRadius=0
RenderShadowResolutionQualityByRam=1
RenderParticlesSimulateQualityLevelBase=1
RenderParticlesNonVisibleSimBudgetMicros=0
RenderLocalLightUpdatesMin=1
RenderLocalLightUpdatesMax=2
CoreGlyphAtlasSize=2048
DevGlyphAtlasWidth=2048
DevGlyphAtlasHeight=2048
UITextureMaxRenderTextureSize=2048
UITextureHighMaxRenderTextureSize=2048
UITextureMediumMaxRenderTextureSize=2048
UITextureLowMaxRenderTextureSize=1024
UITextureLowSingleTextureMemoryMB=64
UITextureMediumSingleTextureMemoryMB=64
UITextureHighSingleTextureMemoryMB=128
UITextureLowMaxSingleTextureMemoryMB=64
UITextureMediumMaxSingleTextureMemoryMB=128
UITextureHighMaxSingleTextureMemoryMB=256
UITextureLowMaxTotalTextureMemoryMB=256
UITextureMediumMaxTotalTextureMemoryMB=512
UITextureHighMaxTotalTextureMemoryMB=1024
TaskSchedulerTargetFps=1000
GraphicsOptimizationModeFRMFrameRateTarget=1000
GraphicsOptimizationModeMaxFrameTimeTargetMs=1
