# wraith-fflag-profile 1
# revision=2
# Lowest look: blocky textures, lowest mesh LOD, no grass, no SSAO/bloom, gray default sky.
# Apply on the Roblox home screen, then join. Games with their own skybox ignore gray sky.
roblox_version=version-11f155f3450f4c8e
DebugFRMQualityLevelOverride=1
DebugForceMSAASamples=0
DebugFRMOptionalMSAALevelOverride=0
SSAO=0
SSAOMipLevels=0
BloomFrmCutoff=21
RobloxGuiBlurIntensity=0
FRMMaxGrassDistance=0
FRMMinGrassDistance=0
DebugSkyGray=1
Clouds=0
DebugRenderMeshForceLod=3
DebugRenderMeshesBudgetMb=1
DebugRenderMeshLodSkipSingleLod=1
DebugRenderMeshManagerDisableControlByHarmony=1
DebugRenderMeshManagerMaxUtility=1
DebugRenderMeshManagerGreedy=1
SlimForceLOD=1
SlimLODBias=4
SlimLoaderForceDropLODs=1
EnableCLoD=1
StreamingModelLodRadiusPercent=10
CSGLevelOfDetailSwitchingDistance=0
CSGLevelOfDetailSwitchingDistanceL12=0
CSGLevelOfDetailSwitchingDistanceL23=0
CSGLevelOfDetailSwitchingDistanceL34=0
CSGv2LodLevel1Percentage=0
CSGv2LodLevel2Percentage=0
CSGv2LodLevel3Percentage=0
CSGv2LodLevel4Percentage=100
EnableCoarseShading=1
DebugForceAnisoOff=1
DebugTextureManagerSkipMips=8
DebugAdditionalNumberOfMipsToSkipForNonAlbedoTextures=8
DebugLimitMinTextureResolutionWhenSkipMips=16
GraphicsTextureReductionVulkan=1
GraphicsTextureReductionD3D11=1
GraphicsTextureReductionOpenGL=1
RenderTextureMipBias=4
ReducedTranscoderTextureDimensionMax=32
SimRuntimeContentTextureTranscodeMaxDim=32
TTranscoderDecalPixelated=1
TextureCompositorActiveJobs=0
TextureCompositorLowResFactor=8
TerrainOTAMaxTextureSize=16
TerrainAtlasTileSize=16
TerrainLodActive=1
DebugTerrainForceDownsampleFromLOD0=1
DebugTerrainForceHQShader=0
TerrainPow2LodBiasPercent=400
DebugPauseVoxelizer=1
RenderShadowmapBias=80
RenderShadowHugeRadius=0
RenderShadowResolutionQualityByRam=1
RenderLocalLightUpdatesMin=1
RenderLocalLightUpdatesMax=1
DebugForceFSMCPULightCulling=1
FastGPULightCulling3=1
RenderParticlesSimulateQualityLevelBase=1
RenderParticlesNonVisibleSimBudgetMicros=0
AnimationLodDistanceMaxLod0=0
AnimationLodDistanceMaxLod1=0
TaskSchedulerTargetFps=1000
GraphicsOptimizationModeFRMFrameRateTarget=1000
GraphicsOptimizationModeMaxFrameTimeTargetMs=1
